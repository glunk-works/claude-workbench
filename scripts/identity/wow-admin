#!/bin/sh
# Host command: a one-hour admin token for one repo's container, or its revocation (WB-D24, #374).
#
#   wow-admin <owner/name> [--perms perm=level[,perm=level...]]
#   wow-admin <owner/name> --revoke
#
# Run it by its path, not through a symlink: it finds wow-common.sh and mint.sh beside itself.
#
# Mint: asks for the admin key's passphrase on the terminal (echo off, read from /dev/tty, never
# an argument or an environment variable), unlocks the admin key into a private .unlock.*
# directory under $WOW_HOME for the length of one mint.sh call, and writes the token and its
# expires_at to $WOW_HOME/tokens/<owner>/<name>/admin-token -- the directory the repo's dev
# container mounts read-only (#1340). That is the only file mint writes. The token is scoped to
# <name> and to --perms (default: administration, contents and pull_requests, all write). It
# refuses a key file that is not passphrase-encrypted (the passphrase would guard nothing),
# refuses to run beside another wow-admin for the same repo name (any owner), and refuses while a live (or
# unreadable) token is on file: an overwritten token could no longer be revoked, so --revoke it
# first (or delete a malformed file by hand). An expired token is simply replaced.
#
# Only mint reads $WOW_HOME/broker.json, and it is not required. When it exists, mint checks it by
# the broker's own rules first (not JSON, empty or non-string repos, a bare-name entry, more than
# one slash, a half failing the name rule, two name halves equal ignoring case, an owner equal to
# another entry's name), then refuses an entry whose name half matches <name> only ignoring case,
# an entry with the same name half under another owner, and an <owner> equal to the name half of
# an entry other than the argument's own. Reading it needs jq. Mint then reads every
# tokens/*/<name>/admin-token under another owner and the leftover tokens/<name>/admin-token, and
# refuses while one is live, so a mistyped owner cannot leave a second live admin token for the
# repo. All of that happens under the per-name lock and before any token directory, passphrase or curl request.
#
# --revoke reads no broker.json and makes none of those refusals. Under the same per-name lock
# it acts only on tokens/<owner>/<name>/admin-token (the argument's path) and on a leftover
# tokens/<name>/admin-token from before #1340: DELETE /installation/token once for each distinct
# token on file, the leftover copy first, then remove each copy on its own token's answer. HTTP
# 401 means the token was already expired or revoked; the copy goes and the exit is 0. Any other
# status keeps that token's copies and the exit is 1. The lock is the directory
# $WOW_HOME/.admin-lock.<name, lowercased>; one left by a killed run blocks mint and revoke alike: rmdir it by hand.
#
# The owner half is a label: wow-admin does not check it against the admin App's installation.
# The token is minted for <name> on that one installation, and the typed owner alone picks the
# directory it lands in, with no broker.json entry needed. An owner whose tokens/<owner>/<name>
# another org's container mounts would put the admin token in that container; the only guard is
# the rule that one identity home serves one org (docs/identity/DEV-CONTAINER.md, WB-D42).
#
# $WOW_TTY names the terminal to read (default /dev/tty); the fixtures point it at a file, and
# only then is a terminal that cannot hide echo accepted. It can only supply a passphrase the
# caller already holds. Layout and toolset: wow-common.sh. Exit 0 on success, 1 on failure, 2 on
# bad usage.
set -eu
set -f
prog=wow-admin
here=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
. "$here/wow-common.sh"

default_perms=administration=write,contents=write,pull_requests=write
usage() { die "usage: wow-admin <owner/name> [--perms p=l,...] | wow-admin <owner/name> --revoke" 2; }

arg= perms=$default_perms perms_given= revoke=
while [ $# -gt 0 ]; do
  case "$1" in
    --revoke) revoke=1 ;;
    --perms) [ $# -ge 2 ] || usage; perms=$2; perms_given=1; shift ;;
    -*) usage ;;
    *) [ -z "$arg" ] || usage; arg=$1 ;;
  esac
  shift
done
[ -n "$arg" ] || usage
case "$arg" in */*/* | */ | /*) usage ;; */*) ;; *) usage ;; esac
owner=${arg%%/*} repo=${arg#*/}
case "$owner" in . | ..) usage ;; esac
check_repo "$owner"
case "$owner" in .* | *.) die "the owner half must not begin or end with a dot" 2 ;; esac
check_repo "$repo"
[ -z "$revoke" ] || [ -z "$perms_given" ] || usage

owndir=$wow_home/tokens/$owner/$repo
ownfile=$owndir/admin-token
# the layout before #1340: only read, to refuse beside a live one and to revoke it
tokfile=$wow_home/tokens/$repo/admin-token
# one lock per repo NAME (any owner, any case), outside every directory a container mounts
lock=$wow_home/.admin-lock.$(printf '%s' "$repo" | tr A-Z a-z)
tty=${WOW_TTY:-/dev/tty}
tmpd=
restore=
locked=
cleanup() {
  [ -z "$restore" ] || stty echo <"$tty" 2>/dev/null || true
  [ -z "$tmpd" ] || rm -rf -- "$tmpd" || true
  [ -z "$locked" ] || rmdir -- "$lock" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
# One lock per repo name, taken by mint and revoke alike before anything is read, so two runs for
# one name under different owners cannot both pass the other-owner check, and a revoke cannot
# delete the file a concurrent mint has just replaced. A SIGKILL leaves it behind: the message says to remove it.
take_lock() {
  [ -d "$wow_home" ] || die "no identity home at $wow_home"
  mkdir -- "$lock" 2>/dev/null || die "another wow-admin is running for the repo name $repo (or left $lock behind; remove it)"
  locked=1
}

# live_check <file> <owner/name to revoke>: refuse while a live or unreadable token is on file; an expired one passes.
live_check() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  exp=$(sed -n 2p "$1" 2>/dev/null || true)
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  case "$exp" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) [ "$exp" \< "$now" ] || die "a live admin token for $repo is on file in $1 (expires $exp); run: wow-admin $2 --revoke" ;;
    *) die "unreadable expiry in $1; run: wow-admin $2 --revoke, or delete the file by hand" ;;
  esac
}

take_lock

# Mint only: broker.json (when present) is checked by the broker's own rules and against the
# argument, under the lock and before anything is created, unlocked or sent.
if [ -z "$revoke" ]; then
  if [ -e "$wow_home/broker.json" ] || [ -L "$wow_home/broker.json" ]; then
    command -v jq >/dev/null 2>&1 || die "jq not on PATH"
    bj=$(jq -rs --arg owner "$owner" --arg name "$repo" '
      def good: type == "string" and test("\\A[A-Za-z0-9._-]+\\z") and (test("\\A[-.]") | not) and (test("\\.\\z") | not);
      if length != 1 then "bad" else .[0] | if type != "object" or (.repos | type) != "array" or (.repos | length) == 0 then "bad"
      elif (.repos | map(type == "string") | all | not) then "bad"
      else
        (.repos | map(split("/"))) as $p
        | if ($p | map(length < 1 or length > 2) | any) then "bad"
          elif ($p | map(all(.[]; good)) | all | not) then "bad"
          elif ($p | map(length == 1) | any) then "bare"
          else
            ($p | map({n: .[1], o: .[0]})) as $e
            | ($e | map(.n | ascii_downcase)) as $ns
            | if ($ns | length) != ($ns | unique | length) then "bad"
              elif ([range(0; $e | length) as $i | select($e[$i].o != null)
                     | range(0; $e | length) as $k | select($k != $i and $ns[$k] == ($e[$i].o | ascii_downcase))] | length) > 0 then "bad"
              elif ([$e[] | select(.n != $name and (.n | ascii_downcase) == ($name | ascii_downcase))] | length) > 0
                then "case\t" + ([$e[] | select(.n != $name and (.n | ascii_downcase) == ($name | ascii_downcase)) | .o + "/" + .n] | first)
              elif ([$e[] | select(.n == $name and .o != $owner)] | length) > 0
                then "other\t" + ([$e[] | select(.n == $name and .o != $owner) | .o + "/" + .n] | first)
              elif ([$e[] | select((.n | ascii_downcase) == ($owner | ascii_downcase) and (.o != $owner or .n != $name))] | length) > 0
                then "ownername\t" + ([$e[] | select((.n | ascii_downcase) == ($owner | ascii_downcase) and (.o != $owner or .n != $name)) | .o + "/" + .n] | first)
              else "ok"
              end
          end
      end end' "$wow_home/broker.json" 2>/dev/null | tr -d '\r') || bj=bad
    ent=${bj#*"	"}
    case "$bj" in
      ok) ;;
      bare) die "$wow_home/broker.json has a bare-name entry, which is no longer accepted; rewrite it as owner/name and run wow-admin again" ;;
      case"	"*) die "broker.json entry $ent matches $repo only ignoring case; refusing $arg (name it exactly as the entry does)" ;;
      other"	"*) die "broker.json names $ent for $repo; refusing $arg under another owner" ;;
      ownername"	"*) die "the owner $owner is the name half of broker.json entry $ent, whose tokens/$owner directory would then hold this admin token; refusing $arg" ;;
      *) die "$wow_home/broker.json is not a valid broker config; fix it and run wow-admin again" ;;
    esac
  fi
  # Every other owner's copy for this repo, read with globbing on for this one expansion only
  # (this script runs with set -f). A pattern that matches nothing stays literal and is skipped.
  set +f
  set -- "$wow_home"/tokens/*/"$repo"/admin-token
  set -f
  for f in "$@"; do
    [ "$f" != "$ownfile" ] || continue
    [ -e "$f" ] || [ -L "$f" ] || continue
    d=${f%/*}; d=${d%/*}; o=${d##*/}
    live_check "$f" "$o/$repo"
  done
  # a live leftover from before #1340 blocks a mint too; --revoke clears it
  live_check "$tokfile" "$arg"
fi

# tok_of <file>: the token on its first line, only if token-shaped; else die.
tok_of() {
  t=$(sed -n 1p "$1") || die "cannot read $1"
  case "$t" in ghs_*) b=${t#ghs_} ;; *) b= ;; esac
  case "$b" in *[!A-Za-z0-9._-]*) b= ;; esac
  [ "${#b}" -ge 36 ] || die "$1 does not hold a token; delete it by hand"
  printf '%s\n' "$t"
}

# delete_token <token>: DELETE /installation/token; sets $code. Returns 1 if curl itself failed.
delete_token() {
  reply=$(
    {
      printf 'url = "https://api.github.com/installation/token"\n'
      printf 'request = "DELETE"\n'
      printf 'header = "Authorization: Bearer %s"\n' "$1"
      printf 'header = "Accept: application/vnd.github+json"\n'
      printf 'header = "X-GitHub-Api-Version: 2022-11-28"\n'
    } | curl -q -sS --max-time 30 -K - -w '\n%{http_code}'
  ) || return 1
  code=${reply##*
}
}

if [ -n "$revoke" ]; then
  command -v curl >/dev/null 2>&1 || die "curl not on PATH"
  have_bare= have_own=
  [ ! -r "$tokfile" ] || have_bare=1
  [ ! -r "$ownfile" ] || have_own=1
  [ -n "$have_bare$have_own" ] || die "no readable admin token on file for $arg"
  t1= t2=
  [ -z "$have_bare" ] || t1=$(tok_of "$tokfile")
  [ -z "$have_own" ] || t2=$(tok_of "$ownfile")
  # one DELETE per distinct token; each copy goes on its own token's 204 or 401
  failed=
  settle() {
    case "$code" in
      204) rm -f -- "$@"; echo "revoked the admin token for $arg" ;;
      401) rm -f -- "$@"; echo "the admin token for $arg was already expired or revoked" ;;
      *) failed="GitHub answered HTTP $code; the token file is kept" ;;
    esac
  }
  if [ -n "$t1" ]; then
    delete_token "$t1" || die "curl failed"
    if [ "$t2" = "$t1" ]; then settle "$tokfile" "$ownfile"; else settle "$tokfile"; fi
  fi
  if [ -n "$t2" ] && [ "$t2" != "$t1" ]; then
    delete_token "$t2" || die "curl failed"
    settle "$ownfile"
  fi
  [ -z "$failed" ] || die "$failed"
  exit 0
fi

for tool in jq openssl curl; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool not on PATH"
done
client_id=$(app_get admin client_id) inst_id=$(app_get admin installation_id) adminkey=$(app_key admin)
[ -n "$client_id" ] && [ -n "$inst_id" ] || die "admin client_id / installation_id / key missing or unusable in $wow_home/apps.json (entries are keyed by role: admin, review)"
[ -n "$adminkey" ] && [ -r "$adminkey" ] || die "admin key file not readable"
# openssl ignores -passin for a plaintext key, so any typed passphrase would "unlock" it.
head -n 3 "$adminkey" | grep -q 'ENCRYPTED' || die "the admin key is not passphrase-encrypted; refusing"

[ -r "$tty" ] || die "no terminal to ask for the passphrase on"

token_dir tokens "$owner/$repo" >/dev/null
live_check "$ownfile" "$arg"

printf 'Admin key passphrase: ' >&2
if stty -echo <"$tty" 2>/dev/null; then
  restore=1
elif [ -z "${WOW_TTY:-}" ]; then
  echo >&2
  die "cannot turn terminal echo off; refusing to show the passphrase"
fi
IFS= read -r pass <"$tty" || { echo >&2; die "no passphrase read"; }
[ -z "$restore" ] || { stty echo <"$tty" 2>/dev/null || true; restore=; }
echo >&2
[ -n "$pass" ] || die "empty passphrase"

tmpd=$(umask 077 && mktemp -d -- "$wow_home/.unlock.XXXXXX") || die "cannot make a private directory under $wow_home"
printf '%s\n' "$pass" | openssl pkey -in "$adminkey" -passin stdin -out "$tmpd/key.pem" 2>/dev/null \
  || die "could not unlock the admin key (wrong passphrase?)"
pass=

sh "$here/mint.sh" --client-id "$client_id" --installation-id "$inst_id" --key "$tmpd/key.pem" \
  --repos "$repo" --perms "$perms" --out "$ownfile"
echo "admin token for $arg written to $ownfile (read-only mount target); revoke with: wow-admin $arg --revoke"
