{
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "strictPluginOnlyCustomization": true,
  "allowManagedMcpServersOnly": true,
  "sandbox": { "enabled": false },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "mcp__loopgit__git_status",
      "mcp__loopgit__git_diff",
      "mcp__loopgit__git_log",
      "mcp__loopgit__git_add",
      "mcp__loopgit__git_commit"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(//run/loop/**)",
      "Read(//proc/**)",
      "Read(**/.credentials.json)",
      "Read(**/.claude/remote-settings.json)",
      "Edit(**/.git/**)",
      "Edit(**/.git)",
      "Write(**/.git)",
      "Edit(**/.gitmodules)",
      "Write(**/.gitmodules)",
      "Edit(//run/loop/**)",
      "Write(//run/loop/**)",
      "Edit(//home/app/**)",
      "Write(//home/app/**)",
      "Write(**/.git/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.ai/**)",
      "Write(.ai/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(**/.mcp.json)",
      "Write(**/.mcp.json)",
      "Edit(.claude-plugin/**)",
      "Write(.claude-plugin/**)",
      "Edit(plugins/way-of-working/.claude-plugin/**)",
      "Write(plugins/way-of-working/.claude-plugin/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)"
    ],
    "defaultMode": "dontAsk"
  }
}
